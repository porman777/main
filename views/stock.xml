        <record id="view_move_history_tree" model="ir.ui.view">
            <field name="name">Item Move History List</field>
            <field name="model">stock.move.line</field>
            <field name="arch" type="xml">
                <list string="Item Move History" default_order="date desc">
                    <field name="date"/>
                    <field name="product_id"/>  
                    <field name="lot_id"/>
                    <field name="location_id"/>
                    <field name="location_dest_id"/>
                    <field name="quantity" column_invisible="1"/>
                    <!-- <field name="total_signed_qty"/> -->
                    <field name="signed_qty"
                        widget="float"
                        decoration-danger="signed_qty &lt; 0"
                        decoration-success="signed_qty &gt;= 0"/>
                    <field name="picking_id"/>
                </list>
            </field>
        </record>


        <menuitem id="menu_move_history"
            name="IMH"
            web_icon="ml_development,static/description/move_history.png"
            action="action_move_history"
            groups="ml_development.group_recieving_manager_inventory,ml_development.group_stock_custodian" 
            sequence="12"/>
        
        <record id="action_stock_quant_list" model="ir.actions.act_window">
            <field name="name">Stock Overview</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': 'usage'}</field>
        </record>

        <record id="view_location_form_inherit" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit.lncr.vismin</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="inside">
                    <group string="Zone">   
                        <field name="lncr"/>
                        <field name="vismin"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Directly go to product listing after clicking the Products menu inside the Inventory Module -->
        <menuitem id="menu_stock_inventory_control" 
            name="Products" parent="stock.menu_stock_root" 
            action="stock.product_template_action_product" 
            sequence="4"/>

        <menuitem id="menu_stock_quant"
            name="SO"
            web_icon="ml_development,static/description/stock_overview.png"
            action="action_stock_quant_list"
            groups="ml_development.group_recieving_manager_inventory,ml_development.group_stock_custodian" 
            sequence="16"/>
        
        <!-- Inherit Inventory Menu -->
        <menuitem id="stock.menu_stock_root"
            name="Inventory"
            web_icon="stock,static/description/icon.png"
            action="stock.stock_picking_type_action"
            groups="base.group_system,ml_development.group_recieving_manager_inventory,ml_development.group_stock_custodian" 
            sequence="140"/>

        <record id="view_warehouse_form_inherit_lncr_vismin" model="ir.ui.view">
            <field name="name">stock.warehouse.form.inherit.lncr.vismin</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="inside">
                    <group string="Zone">
                        <field name="lncr"/>
                        <field name="vismin"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- stock.view_move_line_form  -->
        <record id="view_move_line_form_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.form.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="widget">statusbar</attribute>
                    <attribute name="statusbar_visible">draft,confirmed,done</attribute>
                </xpath>
                <xpath expr="//field[@name='owner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='lot_id']" position="before">
                    <field name="remaining_quantity" string="Remaining Quantity"/>
                    <field name="zone" />
                </xpath>
                <xpath expr="//sheet" position="after">
                    <chatter/>
                </xpath>



            </field>
        </record>

        <!-- Extend the existing stock.quant tree view -->
        <!-- <record id="view_stock_quant_tree_custom" model="ir.ui.view">
            <field name="name">stock.quant.tree.custom</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='reserved_quantity']" position="replace">
                    <field name="inventory_quantity_auto_apply" />
                </xpath>
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="zone" />
                </xpath>
              
            </field>
        </record> -->

        <record id="view_uom_category_tree_inherit" model="ir.ui.view">
            <field name="name">uom.category.list.inherit</field>
            <field name="model">uom.category</field>
            <field name="inherit_id" ref="uom.product_uom_categ_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-danger">name == 'Obsolete'</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="description" />
                </xpath>
            </field>
        </record>

        <!-- Inherit Form View -->
        <record id="view_uom_category_form_inherit" model="ir.ui.view">
            <field name="name">uom.category.form.inherit</field>
            <field name="model">uom.category</field>
            <field name="inherit_id" ref="uom.product_uom_categ_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="description" />
                </xpath>
            </field>
        </record>

        <!-- Stock Return  -->
         <record id="ml_development_stock_return_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.return.picking.form.inherit</field>
            <field name="model">stock.return.picking</field>
            <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
            <field name="arch" type="xml">
                <!-- Add a return reason field above the product_return_moves list -->
                <xpath expr="//field[@name='product_return_moves']" position="before">
                    <field name="return_reason" placeholder="Reason for Return"/>
                </xpath>
                <!-- Customize footer or add another button -->
                <!-- <xpath expr="//footer" position="inside">
                    <button name="action_custom_create_returns"
                        string="Custom Return"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'done')]}"/>
                </xpath> -->
                <!-- Hide "Return All" button -->
                <xpath expr="//footer/button[@name='action_create_returns_all']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Hide "Return for Exchange" button -->
                <xpath expr="//footer/button[@name='action_create_exchanges']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='product_return_moves']/list" position="attributes">
                    <attribute name="create">0</attribute>
                </xpath>
            </field>
        </record>
    </data>
