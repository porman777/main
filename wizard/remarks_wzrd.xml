<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_remarks_wizard_form" model="ir.ui.view">
        <field name="name">remarks.wizard.form</field>
        <field name="model">remarks.wizard</field>
        <field name="arch" type="xml">
            <form string="View Remarks">
                <group>
                    <field name="remarks"/>
                </group>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Form View Description -->
    <record id="action_remarks_wizard" model="ir.actions.act_window">
        <field name="name">View Description</field>
        <field name="res_model">remarks.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_remarks_wizard_form"/>
    </record>

</odoo>
