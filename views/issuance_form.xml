<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="issuance_view_form" model="ir.ui.view">
        <field name="name">issuance.form.view.form</field>
        <field name="model">issuance.form</field>
        <field name="arch" type="xml">
            <form string="Issuance Form"> 
                <header>
                    <button name="button_approve" 
                            type="object" 
                            invisible="state in ['done', 'draft','cancel']"  
                            string="Confirm" 
                            class="oe_highlight"  
                            data-hotkey="z" 
                            readonly="state == 'done'"/>

                    <button name="action_open_send_email_wizard" 
                            type="object"  
                            invisible="state in ['done', 'cancel']"  
                            string="Send as Email" 
                            class="oe_highlight"  
                            data-hotkey="z" 
                            readonly="state == 'done'"/> 
                            
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,done" readonly="1"/>
                    <button name="action_cancel_issuance" string="Cancel"
                        type="object"
                        invisible="state not in ['sent']" />
                </header>
                <sheet>
                
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="online_request_number" readonly="state not in ['draft']"/>
                            <!-- <field name="branch"/> -->
                            <field name="company_id"  invisible="1" readonly="state not in ['draft']"/>
                            <field name="company_id_report"  readonly="state not in ['draft']"/>
                            <field name="location_id" invisible="isZone in ['vismin', 'lncr']"/>
                            <!-- <field name="location_id"/>  -->
                            <field name="location_id_related" invisible="isZone in ['all']"/>
                            <field name="date_issued" />
                            <field name="isZone"  invisible="1"  /> 
                            <field name="zone_filter" invisible="1"  />
                        </group>

                        <group>
                            <field name="assigned_to" readonly="state not in ['draft']" required="isZone == 'lncr'" domain="[('zone','in',['ncr','luzon'])]" invisible="isZone != 'lncr'"  options="{'no_create': True, 'no_quick_create': True}" />
                            <field name="assigned_to_vismin" required="isZone == 'vismin'" domain="[('zone','in',['visayas','mindanao'])]" invisible="isZone != 'vismin'" readonly="state != 'draft'"  options="{'no_create': True, 'no_quick_create': True}" />
                            <field name="assigned_to_all" required="isZone == False" readonly="state != 'draft'" invisible="isZone != 'all' "    options="{'no_create': True, 'no_quick_create': True}" />
                            <field name="assigned_to_selected" invisible="1"/>
                            <field name="zone" required="isZone == 'lncr'"   invisible="isZone != 'lncr'" />
                            <field name="zone_vismin" required="isZone == 'vismin'" invisible="isZone != 'vismin'"  />
                            <field name="zone_all" invisible="isZone != 'all' "  />
                            <field name="region" invisible="isZone != 'lncr'"  />
                            <field name="region_vismin" invisible="isZone != 'vismin'" />
                            <field name="region_all"  invisible="isZone != 'all'"  />
                            <field name="remarks" />
                            <!-- <field name="am_email" />
                            <field name="rm_email" /> -->
                        </group>
                        
                    </group>

                    <notebook>
                        <page name="issuance_lines" string="Issuance Lines">
                            <field name="issuance_line_ids" nolabel="1" readonly="state not in ['draft']">
                                <list editable="bottom">
                                    <field name="location_id" optional="hide"   />
                                    <field name="location_id_related" readonly="1" />
                                    <field name="item_code"  invisible="1" optional="hide"/>
                                    <field name="item_code_related"  readonly="1" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"    />
                                    <field name="location_dest_id"   optional="hide" /> 
                                </list>                         
                            </field>
                        </page>

                        <page name="allocation_table" string="Allocation Table">
                            <field name="allocation_table" nolabel="1" readonly="state not in ['draft']"> 
                                <list editable="bottom">
                                    <!-- <field name="location_id"  optional="hide" />
                                    <field name="location_id_related" readonly="1" />
                                    <field name="item_code"  optional="hide"/>
                                    <field name="item_code_related"  readonly="1" />
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"  optional="hide"  />
                                    <field name="location_dest_id"   optional="hide" />  -->
                                </list>                         
                            </field>
                        </page>

                    </notebook>
                   
                    <group>
                        <group>  
                            <field name="prepared_by" readonly="state in ['done','cancel']"/> 
                        </group>
                        <group>
                            <field name="released_by" readonly="state in ['cancel']"/> 
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="issuance_view_tree" model="ir.ui.view">
        <field name="name">issuance.view.tree</field>
        <field name="model">issuance.form</field>
        <field name="arch" type="xml">
            <list string="Issuance Forms" default_order="name desc">
                <field name="name"/>
                <field name="online_request_number"/>
                <field name="assigned_to_selected"/>
                <field name="prepared_by" />
                <field name="state" />
             
            </list>
        </field>
    </record>

    <record id="issuance_form_action" model="ir.actions.act_window">
        <field name="name">Issuance Form</field>
        <field name="res_model">issuance.form</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create your first issuance here. </p>
        </field>
    </record>

   <menuitem
        id="issuance_form_menu"
        name="IS"
        web_icon="ml_development,static/description/issuance_icon.png"
        groups="base.group_system,ml_development.group_receiving_material_issuance"
        action="issuance_form_action"
        sequence="14"
    />

</odoo>