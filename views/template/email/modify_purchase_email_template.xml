<odoo>
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('name', '=', 'email_template_edi_purchase_done'), ('module', '=', 'purchase')]" />
        </function>
        <value eval="{'noupdate': False}" />
    </function>

    <record id="purchase.email_template_edi_purchase_done" model="mail.template">
        <field name="name">Purchase Order Send to Vendor</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="body_html">
            <![CDATA[
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <strong><t t-esc="object.partner_id.name"/></strong>,</p>
                    <p>
                        Please find the attached purchase order <strong><t t-esc="object.name"/></strong><br/>
                        amounting to <strong><t t-esc="format_amount(object.amount_total, object.currency_id)"/></strong><br/>
                        from <strong><t t-esc="object.corporation.name if object.corporation else 'Our Company'"/></strong>.
                    </p>
                    <p>The receipt is expected by <strong><span t-field="object.expected_arrival" t-options="{'format': 'MM/dd/yyyy'}"/></strong>.</p>
                    <p>Could you please acknowledge the receipt of this order?</p>
                    <p>--<br/>
                        <strong>Purchaser, <t t-esc="user.name"/></strong>
                    </p>
                </div>
            ]]>
        </field>
    </record>
</odoo>
