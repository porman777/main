<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Wizard Form View -->
    <record id="view_my_wizard_approvals_form" model="ir.ui.view">
        <field name="name">view_my_wizard_approvals_form</field>
        <field name="model">res.approvers.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div name="module_group">
                    <group>
                        <!-- Left section: Common fields -->
                        <group name="left_section">
                            <field name="whatModule" widget="badge"/>
                            <field name="name" string="Ref #" readonly="True" />
                            <field name="company_id" readonly="True" />
                            <field name="branch" readonly="True" />
                            <field name="zone" readonly="True" invisible="whatModule != 'po'" />
                            <field name="currency_id" readonly="True" invisible="whatModule != 'po'" />
                            <!-- ::::::::::::: Invisible Fields ::::::::::::: -->
                            <field name="res_approver_id" invisible="True" />
                            <field name="isZone" invisible="True" />
                            <field name="quotation_request_id" invisible="True" />
                            <field name="purchase_order_id" invisible="True" />
                            <field name="purchase_order_id" invisible="True" />
                            <field name="submitted_to" invisible="True" />
                        </group>
                        <!-- Right section -->
                        <group name="right_section">
                            <!-- ::::::::::::: Purchase Order Fields ::::::::::::: -->
                            <group invisible="whatModule != 'po'" colspan="2"> 
                                <field name="terms" readonly="True"/>
                                <field name="expected_arrival" readonly="True" />
                                <field name="description" readonly="True" />
                                <field name="remarks" />
                            </group>
                            <!-- ::::::::::::: Receciving Receipt and Internal Transfer Fields ::::::::::::: -->
                            <group invisible="whatModule not in ['rr','it']" colspan="2"> 
                                <field name="remarks" />
                            </group>

                            <!-- ::::::::::::: Request for Payment Fields ::::::::::::: -->
                            <group invisible="whatModule not in ['rfp']" colspan="2">
                                <field name="payment_terms" readonly="True"/>
                                
                                <field name="remarks" />

                            </group>
                        </group>
                    </group>
                    <group name="list_section">
                        <!-- ::::::::::::: Purchase Order List ::::::::::::: -->
                        <field name="res_approver_items_ids" readonly="True" class="o_form_sheet position-relative" nolabel="1" colspan="2" invisible="whatModule != 'po'">
                            <list editable='bottom' delete="True" create="False" >
                                <field name="item_code" optional="hide" />
                                <field name="product_id" optional="hide" widget="product_label_section_and_note_field" />
                                <field name="item_description" readonly="True" />
                                <field name="product_qty" />
                                <field name="product_uom" />
                                <field name="price_unit" />
                                <field name="taxes_id" optional="hide" widget="many2many_tags" />
                                <field name="tax_duplicate" optional="hide" />
                                <field name="taxed_amount" string='Tax amount' optional="hide" />
                                <field name="amount" string='Tax excl.' />
                            </list>
                        </field>
                        <!-- ::::::::::::: Receciving Receipt and Internal Transfer List ::::::::::::: -->
                        <field name="res_approver_items_ids" nolabel="1" colspan="2" readonly="True" invisible="whatModule not in ['rr','it']">
                            <list editable='bottom'>
                                <field name="product_id" />
                                <field name="product_uom" />
                                <field name="product_qty" />
                                <field name="price_unit" />
                            </list>
                        </field>
                    <!-- ::::::::::::: Request for Payment List ::::::::::::: -->
                        <field name="res_approver_items_ids" nolabel="1" colspan="2" readonly="True" invisible="whatModule != 'rfp'">
                            <list editable='bottom'>
                                <field name="item_code" optional="hide" />
                                <field name="product_id" />
                                <field name="product_qty" />
                                <field name="product_uom" />
                                <field name="price_unit" />
                                <field name="taxes_id" widget="many2many_tags" />
                                <field name="tax_duplicate" optional="hide" />
                                <field name="taxed_amount" string='Tax amount' />
                                <field name="amount" string='Tax excl.' />
                            </list> 
                        </field>
                    </group>
                <!-- Two-Column Layout for Totals -->
                <group colspan="2">
                    <group name="left_totals" invisible="1"/>
                    <group name="totals_section" class="oe_subtotal_footer">
                        <field name="total_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="whatModule not in ['po']" style="font-size: 16px; font-weight: bold;"/>
                        <field name="total_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="whatModule not in ['po']"/>
                        <field name="total_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="whatModule not in ['po']" style="font-size: 20px; font-weight: bold;"/>
                    </group>
                </group>
                <div class="clearfix"/>                    
                </div>
                <footer>
                    <button name="action_approve" string="Approve" type="object" class="btn-approve"/>
                    <button name="action_reject" string="Disapproved" invisible="whatModule != 'po'" type="object" class="btn-disapprove" confirm="Are you sure you want to disapprove? This action cannot be undone."/>
                    <button name="action_request_change" string="Request for Change" invisible="whatModule != 'po'" type="object" class="btn-change" confirm="Requesting a change will move this item back to the revision stage. Do you want to continue?" />
                    <!-- <button string="Close" class="btn-secondary" special="cancel"/> -->
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action View -->
    <record id="my_wizard_approvals_action" model="ir.actions.act_window">
        <field name="name">My Approvals Wizard</field>
        <field name="res_model">res.approvers.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_my_wizard_approvals_form"/>
    </record>

</odoo>
