<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_id_inherit_payment_terms" model="ir.ui.view">
        <field name="name">inherit_payment_terms.view.form.inherit</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <!-- Add custom fields -->
            <xpath expr="//label[@for='early_discount']" position="before">
                <label for="payment_duration"/>
                <div name="payment_duration_div" class="o_row">
                    <field name="payment_duration" class="oe_inline" string="Payment Duration" />
                    <field name="rec_types" class="oe_inline" />
                </div>
            </xpath>
        </field>
    </record>

</odoo>
