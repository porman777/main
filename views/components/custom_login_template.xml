<t name="Login" t-name="web.login">
    <t t-call="web.login_layout">
        <div class="login-wrapper" style="background-size: cover; background-position: center; padding: 50px;">
            <div class="row">
                <!-- Column 1: Welcome Text -->
                <div class="column1">
                    <div class="content-wrapper">
                        <h2>Welcome to ODIS</h2>
                        <p>Streamline your business with our easy-to-use platform</p>
                        <p>Your system is designed to help manage your business more efficiently. From managing Inventory,
                        Expenses, Procurement, to Financial Reporting, ODIS simplifies your day-to-day operations and keeps everything
                        in one secure platform.</p>

                        <!-- This div below shall have border line same as the login button when hovered -->
                        <div class="how-to-login-class">
                            <h4>How to login?</h4>
                            <ul>
                                <li><p>Type your assigned email and password.</p></li>
                                <li><p>Click the login button.</p></li>
                            </ul>
                        </div>
                        <!-- End of the div that has border class -->
                    </div>
                </div>
                <div class="column2">
                    <div class="mt-3" style="margin-left: 90px;">
                        <!-- <owl-component t-if="not login" name="web.user_switch"/> -->
                    </div>
                    <form t-attf-class="oe_login_form #{'' if login else 'd-none'}" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
        
                        <div class="mb-3" t-if="databases and len(databases) &gt; 1">
                            <label for="db" class="col-form-label">Select Database</label>
                            <div class="input-group">
                                <select id="databases" name="databases" class="form-control">
                                    <t t-foreach="databases" t-as="db">
                                        <!-- <option t-att-value="request.db or db" t-att-selected="request.db == db" t-esc="db.replace('_', ' ')"/> -->
                                        <option t-att-value="db" t-esc="db.replace('_', ' ')"/>
                                    </t>
                                </select>
                                <a role="button" class="btn btn-primary-db" id="btn-db">
                                    Select
                                </a>
                            </div>
                        </div>
        
                        <div class="mb-3 field-login">
                            <label for="login" class="form-label d-flex justify-content-between">Email</label>
                            <input type="text" placeholder="Email" name="login" t-att-value="login" id="login" class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
                        </div>
        
                        <div class="mb-3">
                            <label for="password" class="form-label d-flex justify-content-between">Password</label>
                            <input type="password" placeholder="Password" name="password" id="password" class="form-control" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                        </div>
        
                        <p class="alert alert-danger" t-if="error" role="alert">
                            <t t-esc="error"/>
                        </p>
                        <p class="alert alert-success" t-if="message" role="status">
                            <t t-esc="message"/>
                        </p>
        
                        <div class="oe_login_buttons text-center gap-1 d-grid mb-1 pt-3">
                            <button type="submit" class="btn btn-primary">Log in</button>
                            <!--<t t-if="debug">-->
                            <!--    <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">Log in as superuser</button>-->
                            <!--</t>-->
                            <div class="o_login_auth"/>
                        </div>
        
                        <input type="hidden" name="type" value="password"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                    </form>
                </div>
            </div>
        </div>
        <script>
            let btn = document.querySelector('#btn-db');

            btn.addEventListener('click', () =&gt; {
                let database = document.querySelector('#databases').value;
                window.location.href=`http://192.168.1.61:8083/web/login?db=${database}`;
            });

            document.addEventListener('DOMContentLoaded', function() {
                var requestDb = '<t t-esc="request.db"/>'; 
                var selectElement = document.getElementById('databases');
                
                Array.from(selectElement.options).forEach(function(option) {
                    if (option.value === requestDb) {
                        option.selected = true;
                    } 
                });
            });

        </script>
    </t>
</t>