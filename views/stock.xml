<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="your_module_product_product_form_inherit" model="ir.ui.view">
            <field name="name">product.product.form.inherit.hide_standard_price</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//label[@for='standard_price']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                
                <xpath expr="//field[@name='default_code']" position="attributes">
                    <attribute name="readonly">True</attribute>
                </xpath>
            </field>
        </record>


        

        <!-- Hide unnecessary fields and buttons in product form -->
        <record id="view_product_template_form_inherit" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <!-- Hide Cost field -->
                <xpath expr="//label[@for='standard_price']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <!-- Add fields -->
                <xpath expr="//field[@name='invoice_policy']" position="after">
                    <field name="trade_name" invisible="True"/> 

                    <field name="trade_name_supplier" options="{'no_quick_create': True}" domain="[('supplier_rank','>', 0),('x_studio_zone','=','lncr')]" invisible="is_Zone != 'vismin'"/>
                    <field name="trade_name_supplier" options="{'no_quick_create': True}" domain="[('supplier_rank','>', 0),('x_studio_zone','=','vismin')]" invisible="is_Zone != 'lncr'"/>    
                    <field name="is_Zone" invisible="True"/>   

                    <field name="item_code"/>
                    <field name="item_description"/>
                    <field name="suggested_item_type" />
                </xpath>
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="purchase_price"/>
                    <field name="debit_gl_code" readonly="True" />
                    <field name="debit_gl_description" readonly="True" />
                    <field name="credit_gl_code" readonly="True" />
                    <field name="credit_gl_description" readonly="True" />
                    
                    <field name="initial_quantity" invisible="True" />
                    <field name="location_name" required="True"  readonly="False" />
                </xpath>
                <!-- Hide Existing Fields and Buttons -->
                <xpath expr="//button[@name='action_open_documents']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//page[@name='sales']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//field[@name='taxes_id']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//label[@for='list_price']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//div[@name='list_price_uom']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>
                <xpath expr="//label[@for='standard_price']" position="before">
                    <field name="uom_id" class="oe_inline" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

